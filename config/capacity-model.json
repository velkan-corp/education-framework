{
  "schemaVersion": 1,
  "units": "child-facing directed hours per normal term week",
  "unstructuredShareOfNonSchoolWakingTime": 0.3,
  "deliveryModes": {
    "overlay": {
      "label": "School overlay",
      "scope": "An external school owns the complete academic entitlement, cohort provision, records, and credential compliance. Framework hours are incremental and may not duplicate adequate school provision.",
      "academicOwner": "external-school",
      "credentialOwner": "external-school"
    },
    "hybrid": {
      "label": "Hybrid",
      "scope": "A partner school supplies named subjects and credential access; the learning architect owns the cross-provider entitlement and closes documented gaps.",
      "academicOwner": "shared-academic-lead",
      "credentialOwner": "credential-lead"
    },
    "fullSchool": {
      "label": "Full school",
      "scope": "The framework school owns the complete academic entitlement, cohort provision, records, safeguarding, and credential compliance.",
      "academicOwner": "school-academic-lead",
      "credentialOwner": "credential-lead"
    }
  },
  "operatingModes": {
    "minimum": {
      "rule": "Run guarantees only. Use during recovery, transition, examination pressure, illness, or when actual capacity is lower than forecast. Review before adding anything."
    },
    "standard": {
      "rule": "Run guarantees plus exactly the configured choose-N alternative slots. This is the default term mode."
    },
    "intensive": {
      "rule": "Run guarantees plus one time-boxed focus and fewer alternative slots than standard. An intensive replaces work; it never stacks on top of standard."
    }
  },
  "guarantees": {
    "responsive-relationship": "Secure relationship, family connection, and age-appropriate emotional co-regulation.",
    "language-and-communication": "Reading, oral language, writing, rhetoric, or equivalent age-appropriate communication practice.",
    "core-academic-entitlement": "Complete literacy, mathematics, science, and humanities entitlement supplied by the named academic owner.",
    "physical-system": "Sleep protection, daily movement, physical competence, nutrition, and recovery.",
    "collective-capability": "Recurring work in which coordination, disagreement, ensemble, teamwork, or shared accountability is genuinely required.",
    "feedback-and-planning": "A short evidence review that changes the following week's plan; learner ownership increases with age.",
    "protected-autonomy": "The configured share of non-school waking time remains genuinely unstructured and is not reclaimed by framework activities.",
    "safety-and-support": "Safeguarding, health, developmental, and special-support concerns have a named escalation owner."
  },
  "alternativePools": {
    "sensory-nature": "Sensory exploration, outdoor observation, nature, and wonder.",
    "music-movement": "Music, dance, movement, gymnastics, and performance vehicles beyond the physical guarantee.",
    "deep-practice": "One sustained niche or advanced academic, artistic, technical, or athletic practice.",
    "making-projects": "Craft, coding, design, entrepreneurship, repair, and shipped projects.",
    "culture-inquiry": "Literature, history, philosophy, religion, film, mental models, and guided inquiry.",
    "service-leadership": "Service, community contribution, leadership, negotiation, and civic practice.",
    "language-immersion": "A third language, exchange, or concentrated bilingual-register development.",
    "route-launch": "Credential preparation, applications, auditions, research, work placement, and launch logistics."
  },
  "requiredOwnerKeys": [
    "capacity",
    "academic",
    "collective",
    "credential",
    "safeguarding"
  ],
