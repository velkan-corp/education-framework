---
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const ui = isEs ? {
  reset: 'Restablecer valores base', energy: 'Energía', introvert: 'Introvertido', balanced: 'Equilibrado', extrovert: 'Extrovertido',
  reactivity: 'Reactividad', low: 'Baja', high: 'Alta', selfRegulation: 'Autorregulación', communication: 'Comunicación',
  problemSolving: 'Resolución de problemas', grossMotor: 'Motricidad gruesa', fineMotor: 'Motricidad fina', personalSocial: 'Personal-social',
  inhibit: 'Inhibición', shift: 'Cambio', emotionalControl: 'Control emocional', workingMemory: 'Memoria de trabajo', planOrganize: 'Planificación/organización',
} : {
  reset: 'Reset to Baseline', energy: 'Energy', introvert: 'Introvert', balanced: 'Balanced', extrovert: 'Extrovert',
  reactivity: 'Reactivity', low: 'Low', high: 'High', selfRegulation: 'Self-Regulation', communication: 'Communication',
  problemSolving: 'Problem Solving', grossMotor: 'Gross Motor', fineMotor: 'Fine Motor', personalSocial: 'Personal-Social',
  inhibit: 'Inhibit', shift: 'Shift', emotionalControl: 'Emotional Control', workingMemory: 'Working Memory', planOrganize: 'Plan/Organize',
};
---
<!-- SINGLE MOBILE FAB -->
<button type="button" class="profile-fab" id="fab-menu" title="Menu" aria-controls="float-menu" aria-expanded="false">&#9776;</button>

<!-- COMBINED FLOATING PANEL: sections + profile -->
<div class="profile-float" id="float-menu">
  <div id="float-menu-sections"></div>
  <div class="float-panel-divider">
    <div class="profile-float-title">{isEs ? 'Controles de adaptación' : 'Adaptation controls'}</div>
    <div class="profile-notice" role="note">
      {isEs
        ? 'Ayuda de planificación observacional; no es un test, cribado ni diagnóstico. No administra ni puntúa ASQ-3, BRIEF-P ni cuestionarios de Rothbart. Rangos publicados: ASQ-3, 1–66 meses de edad; BRIEF-P, 2–5 años de edad; ECBQ, 18–36 meses de edad; CBQ, 3–7 años de edad.'
        : 'Observational planning aid; not a test, screen, or diagnosis. It does not administer or score ASQ-3, BRIEF-P, or Rothbart questionnaires. Published ranges: ASQ-3, 1–66 months old; BRIEF-P, 2–5 yr olds; ECBQ, 18–36 months old; CBQ, 3–7 yr olds.'}
    </div>

    <!-- Manual controls only; identifiable child data is never bundled. -->
    <button type="button" class="reset-profile-btn" aria-label={ui.reset}>{ui.reset}</button>

    <!-- Research-informed observation controls; not questionnaire administration. -->
    <div class="profile-float-section">{isEs ? 'Observaciones de temperamento' : 'Temperament observations'}</div>
    <div class="profile-label">{ui.energy}</div>
    <div class="radio-group" data-dim="energy" role="group" aria-label={ui.energy}>
      <button type="button" class="radio-btn" data-val="introvert" aria-pressed="false">{ui.introvert}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{ui.balanced}</button>
      <button type="button" class="radio-btn" data-val="extrovert" aria-pressed="false">{ui.extrovert}</button>
    </div>
    <div class="profile-label">{ui.reactivity}</div>
    <div class="radio-group" data-dim="reactivity" role="group" aria-label={ui.reactivity}>
      <button type="button" class="radio-btn" data-val="low" aria-pressed="false">{ui.low}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{ui.balanced}</button>
      <button type="button" class="radio-btn" data-val="high" aria-pressed="false">{ui.high}</button>
    </div>
    <div class="profile-label">{ui.selfRegulation}</div>
    <div class="radio-group" data-dim="selfRegulation" role="group" aria-label={ui.selfRegulation}>
      <button type="button" class="radio-btn" data-val="low" aria-pressed="false">{ui.low}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{ui.balanced}</button>
      <button type="button" class="radio-btn" data-val="high" aria-pressed="false">{ui.high}</button>
    </div>

    <div class="profile-float-section">{isEs ? 'Observaciones del desarrollo' : 'Development observations'}</div>
    <div class="profile-label">{ui.communication}</div>
    <div class="radio-group" data-dim="communication" role="group" aria-label={ui.communication}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.problemSolving}</div>
    <div class="radio-group" data-dim="problemSolving" role="group" aria-label={ui.problemSolving}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.grossMotor}</div>
    <div class="radio-group" data-dim="grossMotor" role="group" aria-label={ui.grossMotor}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.fineMotor}</div>
    <div class="radio-group" data-dim="fineMotor" role="group" aria-label={ui.fineMotor}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.personalSocial}</div>
    <div class="radio-group" data-dim="personalSocial" role="group" aria-label={ui.personalSocial}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>

    <div class="profile-float-section">{isEs ? 'Observaciones de función ejecutiva' : 'Executive-function observations'}</div>
    <div class="profile-label">{ui.inhibit}</div>
    <div class="radio-group" data-dim="inhibit" role="group" aria-label={ui.inhibit}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.shift}</div>
    <div class="radio-group" data-dim="shift" role="group" aria-label={ui.shift}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.emotionalControl}</div>
    <div class="radio-group" data-dim="emotionalControl" role="group" aria-label={ui.emotionalControl}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.workingMemory}</div>
    <div class="radio-group" data-dim="workingMemory" role="group" aria-label={ui.workingMemory}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
    <div class="profile-label">{ui.planOrganize}</div>
    <div class="radio-group" data-dim="planOrganize" role="group" aria-label={ui.planOrganize}>
      <button type="button" class="radio-btn" data-val="developing" aria-pressed="false">{isEs ? 'Apoyo' : 'Support'}</button>
      <button type="button" class="radio-btn active" data-val="balanced" aria-pressed="true">{isEs ? 'Base' : 'Baseline'}</button>
      <button type="button" class="radio-btn" data-val="advanced" aria-pressed="false">{isEs ? 'Reto' : 'Challenge'}</button>
    </div>
  </div>
</div>

<!-- MOBILE SEARCH OVERLAY -->
<div id="mobile-search-overlay">
  <div id="mobile-search-bar">
    <input id="mobile-search-input" type="text" placeholder={isEs ? 'Buscar…' : 'Search…'} autocomplete="off">
    <button type="button" id="mobile-search-close" aria-label={isEs ? 'Cerrar búsqueda' : 'Close search'}>✕</button>
  </div>
  <div id="mobile-search-results"></div>
</div>
